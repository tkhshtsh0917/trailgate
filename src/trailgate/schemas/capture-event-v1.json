{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trailgate:schema:capture-event:v1",
  "title": "Trailgate model-boundary capture event v1",
  "type": "object",
  "required": ["schema_version", "kind", "capture_id", "recorded_at"],
  "properties": {
    "schema_version": {"const": "trailgate.capture.v1"},
    "kind": {"enum": ["begin", "finish", "delivery", "abort"]},
    "capture_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "begin"}}, "required": ["messages", "tools"], "properties": {"messages": {"type": "array"}, "tools": {"type": "array"}, "provider_format": {"enum": ["chat_completions", "openai_responses"]}, "request_parameters": {"type": "object"}}},
    {"properties": {"kind": {"const": "finish"}}, "required": ["assistant_message"], "properties": {"assistant_message": {"type": "object"}, "provider_response": {"type": "object"}}},
    {"properties": {"kind": {"const": "delivery"}}, "required": ["call_id", "observation_id", "value", "truncated"], "properties": {"call_id": {"type": "string", "minLength": 1}, "observation_id": {"type": "string", "minLength": 1}, "truncated": {"type": "boolean"}}},
    {"properties": {"kind": {"const": "abort"}}, "required": ["reason_code"], "properties": {"reason_code": {"type": "string", "minLength": 1}}}
  ]
}
