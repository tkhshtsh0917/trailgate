{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trailgate:schema:api-snapshot-manifest:v1",
  "title": "Trailgate saved Langfuse API snapshot manifest v1",
  "type": "object",
  "required": ["schema_version", "source", "observations_api", "scores_api", "observation_fields", "score_fields", "query", "score_query", "complete"],
  "properties": {
    "schema_version": {"const": "trailgate.langfuse_api_snapshot.v1"},
    "source": {"const": "langfuse"},
    "observations_api": {"const": "v2"},
    "scores_api": {"const": "v3"},
    "observation_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "score_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "query": {"$ref": "#/$defs/observationQuery"},
    "score_query": {"$ref": "#/$defs/scoreQuery"},
    "complete": {"const": true},
    "collection": {"type": "object"}
  },
  "$defs": {
    "observationQuery": {
      "type": "object",
      "required": ["fromStartTime", "toStartTime"],
      "properties": {
        "fromStartTime": {"type": "string"},
        "toStartTime": {"type": "string"}
      }
    },
    "scoreQuery": {
      "type": "object",
      "required": ["fromTimestamp", "toTimestamp"],
      "properties": {
        "fromTimestamp": {"type": "string"},
        "toTimestamp": {"type": "string"}
      }
    }
  }
}
